{
  "expo": {
    "name": "Movement Tracker",
    "slug": "movement-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/android-chrome-512x512.png",
    "splash": {
      "image": "./assets/android-chrome-512x512.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.personal.movementtracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Movement Tracker needs location access to record your activities.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Movement Tracker needs 'Always' location access to track activities while your screen is locked.",
        "NSLocationAlwaysUsageDescription": "Movement Tracker needs 'Always' location access to track activities while your screen is locked.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-chrome-512x512.png",
        "backgroundColor": "#0d1117"
      },
      "package": "com.personal.movementtracker",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Movement Tracker to use your location to record activities in the background.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {}
      ],
      "expo-sharing",
      "expo-splash-screen",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MovementWidget",
              "label": "Movement Tracker",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Weekly goals and stats",
              "previewImage": "./assets/android-chrome-512x512.png"
            }
          ]
        }
      ],
      "expo-font"
    ],
    "scheme": "movement-tracker",
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3c12c4ab-3daa-4919-9525-24534e0f39f2"
      }
    },
    "owner": "himanchal08"
  }
}
